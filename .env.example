# UpSpace 环境变量模板
# 复制为 .env 并填入实际值：cp .env.example .env

# ===== 核心（必填）=====
# 本地 Supabase：pnpm dlx supabase status 获取
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="UpSpace"

# ===== Storage =====
NEXT_PUBLIC_SPACE_IMAGES_BUCKET="space-images"
NEXT_PUBLIC_VERIFICATION_DOCS_BUCKET="verification-docs"

# ===== Google Maps（可选）=====
# 注册：https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ===== Redis（本地）=====
REDIS_URL="redis://localhost:6379"

# ===== AI 助手 =====
# 注册：https://openrouter.ai/
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-haiku-4.5"

# ===== 支付（Xendit）=====
# 注册：https://dashboard.xendit.co/register
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_VERIFICATION_TOKEN=""
XENDIT_CALLBACK_TOKEN=""
XENDIT_API_URL=""
XENDIT_COUNTRY="PH"
FINANCIAL_DATA_ENCRYPTION_KEY=""
CHECKOUT_ALLOWED_REDIRECT_ORIGINS=""

# ===== 邮件（本地用 Inbucket/local_smtp，无需真实凭据）=====
# 本地 SMTP 端口见 supabase/config.toml
EMAIL_SMTP_HOST="127.0.0.1"
EMAIL_SMTP_PORT="54325"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM="noreply@upspace.local"
EMAIL_FROM_NAME="UpSpace"

# ===== 限流覆盖（可选，均有内置默认值）=====
# RATE_LIMIT_SPACES_LIMIT=""
# RATE_LIMIT_SPACES_WINDOW=""
# RATE_LIMIT_SPACES_SUGGEST_LIMIT=""
# RATE_LIMIT_SPACES_SUGGEST_WINDOW=""
# RATE_LIMIT_BOOKING_CHECKOUT_LIMIT=""
# RATE_LIMIT_BOOKING_CHECKOUT_WINDOW=""
# RATE_LIMIT_BOOKING_CANCEL_LIMIT=""
# RATE_LIMIT_BOOKING_CANCEL_WINDOW=""
# RATE_LIMIT_BOOKMARK_TOGGLE_LIMIT=""
# RATE_LIMIT_BOOKMARK_TOGGLE_WINDOW=""
# RATE_LIMIT_CHAT_MESSAGES_LIMIT=""
# RATE_LIMIT_CHAT_MESSAGES_WINDOW=""
# RATE_LIMIT_PARTNER_DASHBOARD_FEED_LIMIT=""
# RATE_LIMIT_PARTNER_DASHBOARD_FEED_WINDOW=""
# RATE_LIMIT_PARTNER_SPACES_LIMIT=""
# RATE_LIMIT_PARTNER_SPACES_WINDOW=""
# RATE_LIMIT_PAYOUT_REQUEST_LIMIT=""
# RATE_LIMIT_PAYOUT_REQUEST_WINDOW=""
# RATE_LIMIT_REVIEW_CREATE_LIMIT=""
# RATE_LIMIT_REVIEW_CREATE_WINDOW=""

